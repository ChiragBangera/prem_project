# Optional. Copy to .env if you use a tool that loads it; the app itself reads plain environment variables.

# Where the local cache (SQLite) lives. Default: <repo>/.prem-data, or ~/.prem-lab when installed.
# PREM_DATA_DIR=/path/to/cache

# Serve a synthetic league that needs no network.
# PREM_DEMO=1

# Never touch the network; serve whatever is cached.
# PREM_OFFLINE=1

# Pretend today is this date (demo and testing).
# PREM_TODAY=2027-03-10
