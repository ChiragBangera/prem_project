# Use a comma-separated list when a separate frontend should call this API.
# The default is * because every endpoint is public and read-only.
FOOTBALL_ANALYTICS_CORS_ORIGINS=*

# ── Phase 5 provider gates ────────────────────────────────────────────────
# Sofascore tactical data (lineups/statistics/shotmap/heatmap/incidents).
# Free, undocumented, bot-monitored — client throttles 1 req/s + jitter,
# backs off 429s, caches 6h in cache/sofa.db.
# Truthy values: 1 / true / yes / on / enabled. Unset = disabled (honest fallbacks).
SOFASCORE_ENABLED=

# api-football.com v3 (fixtures/standings/teams). Free tier: 100 req/day.
# Key sent as x-apisports-key header. Cache: cache/api-football.db.
API_FOOTBALL_KEY=

# football-data.org v4 (competitions/standings/matches/teams). Free tier: 10 req/min.
# Token sent as X-Auth-Token header. Cache: cache/api.db.
FOOTBALL_DATA_TOKEN=
